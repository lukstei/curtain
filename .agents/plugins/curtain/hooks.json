{
	"curtain": {
		"PreInvocation": [
			{
				"type": "command",
				"command": "node ./dist/curtain.mjs hook pre"
			}
		],
		"PreToolUse": [
			{
				"matcher": "view_file|read_file|Read|View|Skill|invoke_subagent",
				"hooks": [
					{
						"type": "command",
						"command": "node ./dist/curtain.mjs hook tool"
					}
				]
			}
		],
		"Stop": [
			{
				"type": "command",
				"command": "node ./dist/curtain.mjs hook stop"
			}
		]
	}
}
